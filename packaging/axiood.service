[Unit]
Description=Axioo Control daemon (EC fan curve + RAPL, PPD sync)
# After SAJA tanpa Wants: Wants terbukti menarik PPD ke transaksi start
# axiood dan menimbulkan ordering cycle saat boot (systemd lalu me-skip
# start axiood → "offline" padahal enabled). Daemon tahan tanpa PPD
# (fallback Balanced), jadi dependensi keras tak diperlukan.
After=power-profiles-daemon.service dbus.service

[Service]
Type=simple
ExecStart=/usr/bin/axiood
Restart=on-failure
RestartSec=3
# Butuh CAP_SYS_RAWIO (port EC 0x62/0x66) + sysfs powercap + ec_sys debugfs.
CapabilityBoundingSet=CAP_SYS_RAWIO
AmbientCapabilities=CAP_SYS_RAWIO

[Install]
WantedBy=multi-user.target
