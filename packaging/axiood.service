[Unit]
Description=Axioo Control daemon (EC fan curve + RAPL, PPD sync)
# SENGAJA tanpa After/Wants ke power-profiles-daemon.service:
# PPD upstream punya After=multi-user.target sementara axiood
# WantedBy=multi-user.target (=> Before=multi-user.target).
# After=PPD menutup cycle: axiood→PPD→multi-user→axiood, sehingga
# systemd me-delete Job axiood.service/start tiap boot ("Found ordering
# cycle", enabled tapi inactive). Daemon tahan tanpa PPD (fallback
# Balanced + retry tiap 3 dtk via polling D-Bus), jadi dependensi
# ordering keras tak diperlukan.
After=dbus.service

[Service]
Type=simple
ExecStart=/usr/bin/axiood
Restart=on-failure
RestartSec=3
# Butuh CAP_SYS_RAWIO (port EC 0x62/0x66) + sysfs powercap + ec_sys debugfs.
CapabilityBoundingSet=CAP_SYS_RAWIO
AmbientCapabilities=CAP_SYS_RAWIO

[Install]
WantedBy=multi-user.target
