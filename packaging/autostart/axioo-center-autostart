#!/usr/bin/env bash
# axioo-center-autostart — stable entry for Axioo Control Center.
#
# Why a wrapper: AppImageLauncher moves/renames the AppImage on every
# integrate/update (e.g. ~/.local/share/axioo-control-center/...AppImage
# → ~/Applications/..._<hash>.AppImage), so a .desktop Exec that hardcodes
# the AppImage path silently goes stale (launcher click does nothing) and
# systemd's xdg-autostart-generator skips it ("executable does not exist").
# This wrapper re-resolves the newest AppImage at every run.
#
# Mode: no argument = show window (app launcher); --minimized = start
# hidden in tray (boot autostart via systemd user unit / .desktop).
# A second instance never duplicates: single-instance plugin kills it and
# raises the first instance's window (Steam-like), so the launcher entry
# and the autostart entry can safely share this wrapper.
#
# Never let AppImageLauncher intercept us: its "integrate?" dialog blocks
# boot-to-tray and its move/rename breaks every hardcoded path. Wrapper
# re-resolves the file each run, so integration buys nothing here.
export APPIMAGELAUNCHER_DISABLE=1
set -u

# Bungkam satu baris warning kosmetik dari library sistem tray
# ("libayatana-appindicator is deprecated..." — bukan bug kita, muncul
# sekali tiap start di journal). Pesan lain tetap lolos apa adanya.
quiet_tray() {
  grep -v "libayatana-appindicator is deprecated" >&2
}

MODE=""
if [[ "${1:-}" == "--minimized" ]]; then MODE="--minimized"; fi

launch() { # $1 = executable
  if [[ -n "$MODE" ]]; then
    exec "$1" --minimized 2> >(quiet_tray)
  else
    exec "$1" 2> >(quiet_tray)
  fi
}

for d in "$HOME/Applications" "$HOME/.local/share/axioo-control-center"; do
  match=$(ls -t "$d"/Axioo\ Control\ Center*.AppImage 2>/dev/null | head -n 1)
  if [[ -n "${match:-}" && -x "$match" ]]; then
    launch "$match"
  fi
done

# Fallback: standalone release binary (bundled frontend, no vite needed).
rel="$HOME/Projects/axioo-control-center/target/release/axioo-center"
if [[ -x "$rel" ]]; then
  launch "$rel"
fi

exit 1
