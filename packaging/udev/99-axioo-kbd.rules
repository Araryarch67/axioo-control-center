# Axioo Control Center — kbd backlight writable by video/input group (tanpa sudo harian)
# Matches rgb:kbd_backlight* dari tuxedo_keyboard / clevo drivers
SUBSYSTEM=="leds", ACTION=="add", KERNEL=="rgb:kbd_backlight*", RUN+="/bin/chgrp video /sys%p/brightness /sys%p/multi_intensity"
SUBSYSTEM=="leds", ACTION=="add", KERNEL=="rgb:kbd_backlight*", RUN+="/bin/chmod g+w /sys%p/brightness /sys%p/multi_intensity"
# Fallback: generic kbd LEDs
SUBSYSTEM=="leds", KERNEL=="*kbd*", GROUP="video", MODE="0664"
