# Maintainer: Araryarch67 <https://github.com/Araryarch67>
pkgname=axioo-control-center-git
pkgver=0.4.0.r0.g0000000
pkgrel=1
pkgdesc="Linux hardware control for Axioo/Clevo laptops (Tauri GUI + fan/RAPL daemon + CLI)"
arch=('x86_64')
url="https://github.com/Araryarch67/axioo-control-center"
license=('AGPL-3.0-or-later')
depends=('dbus' 'gcc-libs' 'glibc' 'gtk3' 'hicolor-icon-theme' 'libayatana-appindicator'
         'librsvg' 'polkit' 'power-profiles-daemon' 'webkit2gtk-4.1')
makedepends=('cargo' 'git' 'gtk3' 'nodejs' 'npm' 'webkit2gtk-4.1')
optdepends=('clevo-drivers-dkms-git: kernel drivers for kbd LED + EC (Studio X quirk)')
provides=('axioo-control-center')
conflicts=('axioo-control-center')
install=axioo-control-center-git.install
source=("git+https://github.com/Araryarch67/axioo-control-center.git")
sha256sums=('SKIP')

pkgver() {
  cd axioo-control-center
  printf "0.4.0.r%s.g%s" "$(git rev-list --count HEAD)" "$(git rev-parse --short HEAD)"
}

prepare() {
  cd axioo-control-center
  # No --locked: upstream does not commit Cargo.lock (see .gitignore),
  # so the AUR clone has none. Plain fetch resolves from Cargo.toml.
  cargo fetch --target x86_64-unknown-linux-gnu
}

build() {
  cd axioo-control-center
  export npm_config_cache="$srcdir/npm-cache"
  # Frontend first: cargo embeds tauri-app/dist when compiling the backend.
  (cd tauri-app && npm ci --no-audit --no-fund && npm run build)
  cargo build --release --workspace
}

package() {
  cd axioo-control-center
  install -Dm755 target/release/axioo-ctl "$pkgdir/usr/bin/axioo-ctl"
  install -Dm755 target/release/axiood "$pkgdir/usr/bin/axiood"
  # Tauri binary is named axioo-center → install as axioo-control-center
  # (matches the desktop file + AppImage name).
  install -Dm755 target/release/axioo-center "$pkgdir/usr/bin/axioo-control-center"
  # Desktop entry + icon
  install -Dm644 packaging/appimage/axioo-control-center.desktop \
    "$pkgdir/usr/share/applications/axioo-control-center.desktop"
  install -Dm644 icons/android-chrome-512x512.png \
    "$pkgdir/usr/share/icons/hicolor/512x512/apps/axioo-control-center.png"
  # D-Bus + polkit
  install -Dm644 packaging/com.axioo.Control.conf \
    "$pkgdir/etc/dbus-1/system.d/com.axioo.Control.conf"
  install -Dm644 packaging/com.axioo.Control.policy \
    "$pkgdir/usr/share/polkit-1/actions/com.axioo.Control.policy"
  # systemd
  install -Dm644 packaging/axiood.service \
    "$pkgdir/usr/lib/systemd/system/axiood.service"
  # udev — writable kbd LEDs
  install -Dm644 packaging/udev/99-axioo-kbd.rules \
    "$pkgdir/usr/lib/udev/rules.d/99-axioo-kbd.rules"
  # docs
  install -Dm644 README.md "$pkgdir/usr/share/doc/axioo-control-center/README.md"
  install -Dm644 docs/ec-fan-protocol.md \
    "$pkgdir/usr/share/doc/axioo-control-center/ec-fan-protocol.md"
  install -Dm644 docs/kbd-backlight.md \
    "$pkgdir/usr/share/doc/axioo-control-center/kbd-backlight.md"
  # man page
  install -Dm644 packaging/man/axioo-ctl.1 \
    "$pkgdir/usr/share/man/man1/axioo-ctl.1"
}
